{
  "format": "tikspot-plugin",
  "version": 1,
  "recipe": {
    "name": "Hotel Guest System (XML, API key)",
    "enabled": false,
    "planGroup": "free",
    "timeoutMs": 8000,
    "allowInsecureTls": false,
    "maxRecords": 200,
    "request": {
      "method": "GET",
      "url": "http://192.168.1.10:8090/guests?room={{input.room}}&format=xml",
      "headers": {
        "X-Api-Key": "{{secret.apiKey}}"
      },
      "contentType": "json",
      "accept": "xml"
    },
    "parse": {
      "type": "xml",
      "root": "guests.guest",
      "fields": {
        "firstName": "firstName",
        "lastName": "lastName",
        "room": "room",
        "mobile": "mobile",
        "email": "email",
        "bookingRef": "bookingRef",
        "checkIn": "checkIn",
        "checkOut": "checkOut"
      },
      "dateFormat": "iso"
    },
    "match": {
      "all": true,
      "rules": [
        {
          "input": "room",
          "field": "room",
          "normalize": "trim"
        },
        {
          "input": "name",
          "anyOf": [
            "firstName",
            "lastName"
          ],
          "normalize": "name"
        }
      ]
    },
    "window": {
      "start": "checkIn",
      "end": "checkOut",
      "leewayHours": 24,
      "maxGrantHours": 168
    },
    "inputs": [
      {
        "name": "room",
        "label": "Room number",
        "type": "text",
        "required": true,
        "placeholder": "e.g. 101"
      },
      {
        "name": "name",
        "label": "Last name (or first name)",
        "type": "text",
        "required": true,
        "placeholder": "Smith"
      }
    ],
    "messages": {
      "noMatch": "We could not find a booking with those details.",
      "outsideWindow": "Your stay is not active yet, or has ended.",
      "upstream": "The guest system is not responding — please try again or ask at reception."
    }
  }
}
